family smith-channel 5

# The receiving host/agent additionally checks aggregate ownership and counts
# against its configured domain Limits. Bytes carried from other codec families
# are bounded here before their own versioned decoders read them.
record CallName { activation: u64 completion: u32 position: u32 }
record Window { turns: u32 bytes: u64 }
record Directory {
    name: text 1024
    path: text 4096
    writable: bool
    git: bool
    conflicts: list 64 text 4096
}
record Workspace { directories: list 64 Directory }
enum Scheme { bearer, key }
record CredentialValue { scheme: Scheme bytes: secret 8192 }
record ProgramValue { name: text 32 }
# Withdrawn; accounts-sources removes the id-and-bearer form.
record WithdrawnValue { id: text 1024 bearer: secret 8192 }
enum GrantValue { credential: CredentialValue, program: ProgramValue, withdrawn: WithdrawnValue }
record Grant {
    account: u32
    generation: u64
    valid: duration
    value: GrantValue
}
record Receipt { directory: u32 text: bytes 512 }
record Delivered { receipts: list 64 Receipt }
record Marker { directory: u32 path: text 4096 }
record DeliveryRefusal { marker: option Marker explanation: text 512 }
enum DeliveryReason {
    unreachable, refused_by_target, timed_out, broken, too_large,
    missing, busy, unavailable, cancelled, unknown
}
record DeliveryFailure {
    directory: u32
    reason: DeliveryReason
    diagnostic: bytes 512
    dropped: u64
}
enum Delivery {
    delivered: Delivered, nothing, refused: DeliveryRefusal,
    failed: DeliveryFailure, stale
}
record HostReply { error: bool text: text 1048576 }
record DeliveryReply { value: Delivery }
enum Reply { host: HostReply, delivery: DeliveryReply, busy, unavailable, withdrawn, too_large }
enum SavedReply { host: HostReply, delivery: DeliveryReply, too_large }
record AnsweredCall { name: CallName tool: text 64 reply: SavedReply }

# Start has all values required to resume; the transcript consists of the
# exact opaque versioned turn bytes told on earlier activations.
record Message { name: u64 label: text 1024 text: text 1048576 finish_requested: bool }
record LiveAsk { text: bool reasoning: bool input: bool }
record Start {
    identity: option fixed 16
    activation: u64
    charter: bytes 67108864
    workspace: option Workspace
    transcript: bytes 536870912
    answered: list 128 AnsweredCall
    grants: list 64 Grant
    window: Window
    messages: list 128 Message
    live: option LiveAsk
}
record HostAnswer { name: CallName reply: Reply }
record Acknowledge { number: u32 }
record GrantRefresh { grant: Grant }
record Cancel {}

record Admitted {}
enum MessageRefusal { too_large, full, name_in_use, ending }
record MessageRefused { name: u64 reason: MessageRefusal }
enum Effect { read, write }
record HostAsk { tool: text 64 input: bytes 1048576 }
record Field { name: text 64 text: text 262144 }
record DeliverAsk { fields: list 32 Field }
enum Ask { host: HostAsk, deliver: DeliverAsk }
record Call { name: CallName effect: Effect deadline: duration ask: Ask }
record Withdraw { name: CallName }
record Turn {
    number: u32
    spent: u64
    last_read: option u64
    opens_window: bool
    body: bytes 16777216
}
record Waiting { last_read: option u64 }
enum Operation { check, completion, command }
record Long { operation: Operation span: duration }
record LongDone {}
record Unauthorized { account: u32 generation: u64 }
record Limited { account: u32 reset: option duration }
record AccountRefused { account: u32 code: text 128 reason: text 512 }

# Facts contain no text or credential values. The kind and count identify
# what happened; elapsed is relative to this activation's start.
enum FactKind {
    admitted, ended, llm_started, llm_retried, llm_finished,
    tool_started, tool_finished, check_started, check_finished, text_arrived
}
record Fact { kind: FactKind elapsed: duration count: u64 }

enum ReceivingLimit { input, output, cache_read, cache_write }
enum Overflow { spend, usage }
record ReceivingLimitValue { value: ReceivingLimit }
record OverflowValue { value: Overflow }
enum BudgetFailure { turns, spend, time, tokens: ReceivingLimitValue, overflow: OverflowValue }
enum Cap {
    request, request_head, response_head, response_fields, skip, field,
    retained, tokens, depth, strings, number, reasoning, output_items,
    metadata, tools, history_items, output, answer, error_body, access_token, account_id
}
record PathCap { value: Cap }
record PoolLimit { reservation: u64 }
enum CompletionLimit { pool: PoolLimit, path: PathCap, history, window, call, message }
record LimitFailure { which: CompletionLimit bound: u64 }
enum CompletionPhase { connect, handshake, head, idle, whole }
record TimeoutFailure { phase: CompletionPhase }
enum CompletionFailure {
    limit: LimitFailure, application_limit, protocol, cancelled, overloaded,
    unavailable, timed_out: TimeoutFailure, context_too_long, invalid,
    unauthorized, rate_limited, exhausted, refused, unsupported
}
record ResponseEvidence { status: option u16 }
enum CompletionEvidence { unsent, unknown, response: ResponseEvidence }
record CompletionFault {
    failure: CompletionFailure
    evidence: CompletionEvidence
    retry_after: option duration
    model: u32
    attempts: u32
    code: text 128
    request_id: text 128
    field: text 128
}
record LimitedFault { account: u32 reset: option duration }
record RefusedFault { account: u32 code: text 128 }
record UnauthorizedFault { account: u32 }
record ProgramFault { name: text 32 exit: option u32 detail: bytes 512 }
enum ModelFault {
    completion: CompletionFault, limited: LimitedFault, provider,
    declined, truncated, malformed, refused: RefusedFault,
    unauthorized: UnauthorizedFault, program: ProgramFault
}
enum TranscriptRefusal { version, malformed, unresolved, too_large }
record TranscriptRefusalValue { value: TranscriptRefusal }
record ModelFaultValue { value: ModelFault }
record BudgetFailureValue { value: BudgetFailure used: option u64 bound: option u64 }
record PolicyFailure { nudges: u32 rejected: u32 }
enum RunFailure {
    transcript: TranscriptRefusalValue, model: ModelFaultValue,
    budget: BudgetFailureValue, policy: PolicyFailure, cancelled, stale
}
enum PriceRate { input, cached, cache_write, output }
record PriceRateValue { value: PriceRate }
enum BudgetPart { turns, spend, time }
record BudgetPartValue { value: BudgetPart }
record BudgetTurns { value: u32 }
record BudgetSpend { value: u64 }
record BudgetTime { value: duration }
enum BudgetCeiling { turns: BudgetTurns, spend: BudgetSpend, time: BudgetTime }
record BudgetCeilingValue { value: BudgetCeiling }
record BudgetCompletion { most: u64 }
record BudgetChecks { reserve: duration checks: duration }
enum BudgetRefusal {
    ceiling: BudgetCeilingValue, empty: BudgetPartValue,
    reserve: BudgetPartValue, completion: BudgetCompletion, checks: BudgetChecks
}
record BudgetRefusalValue { value: BudgetRefusal }
record WindowBound { bound: u64 }
enum InvalidStart {
    charter_version, malformed_charter, activation, window, conventions, too_large,
    workspace, grants, outcome, budget: BudgetRefusalValue, price: PriceRateValue, llm, conversation, endpoint, messages, host_part: WindowBound, room: WindowBound, effort
}
record InvalidStartValue { value: InvalidStart }
enum StartRefusal { busy, invalid: InvalidStartValue }
record Accepted { result: bytes 67108864 }
record Failed { reason: RunFailure }
record Refused { reason: StartRefusal }
enum RunResult { accepted: Accepted, parked, failed: Failed, refused: Refused }
record Answer { turns: u32 spent: u64 last_read: option u64 result: RunResult }

enum LiveKind { text, reasoning, input }
record LiveCall { id: text 256 tool: text 64 }
record Live { turn: u32 retry: u32 kind: LiveKind offset: u64 bytes: bytes 4096 call: option LiveCall }

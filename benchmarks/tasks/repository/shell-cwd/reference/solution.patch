+        );
+        assert_eq!((head, tail), (LIMITS.shell_head, LIMITS.shell_tail));
+        assert_eq!(h.end(owner, Done::Cancelled), (7, Outcome::Cancelled));
+        let (owner, op, _) = spawned(&mut h, kit, None);
+        let Op::Spawn { cwd, .. } = op else { panic!("expected a shell spawn") };
+        assert_eq!(cwd, place(1, b""), "omitting cwd always uses the original directory");

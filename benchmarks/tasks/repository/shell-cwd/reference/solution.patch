+#[test]
+fn shell_cwd_keeps_grants_timeout_clamping_and_cancellation() {
+    let mut h = Harness::new(LIMITS);
+    let grants = Grants { inspect: false, modify: false, shell: true };
+    let kit = h.open(1, authority(grants));
+    for (timeout, outer, expected) in [
+        (None, at(3600), at(60)),
+        (Some(Duration::from_secs(7200)), at(3600), at(600)),
+        (Some(Duration::from_secs(5)), at(2), at(2)),
+    ] {
+        let call = Call::ShellIn { command: bytes(b"sleep 9"), timeout, cwd: path(b"vendor/lib") };
+        let event = Event::Call { kit, reply_to: ReplyTo::new(Token::new(8)), call, deadline: outer };
+        let Some(Request::Io { owner, op: Op::Spawn { roots, .. }, deadline }) = h.step(event) else {
+            panic!("shell needs no inspect or modify grant");
+        };
+        assert_eq!(deadline, expected);
+        for root in &roots {
+            assert!(!root.writable, "cwd never adds write authority");
+        }
+        assert_eq!(h.end(owner, Done::Cancelled), (8, Outcome::Cancelled));
+        h.domain.reclaim();
+    }
+    let other = h.open(2, authority(Grants { inspect: true, modify: true, shell: false }));
+    let call = Call::ShellIn { command: bytes(b"pwd"), timeout: None, cwd: path(b"src") };
+    assert_eq!(h.call(other, call.clone()), Outcome::NotGranted);
+    let Some(Request::Io { owner, .. }) = h.send(kit, 9, call) else { panic!("shell starts") };
+    assert_eq!(h.step(Event::Close { kit }), Some(Request::CancelIo { owner }));
+    let ended = h.emit(Event::Done { owner, done: Done::Cancelled });
+    assert_eq!(
+        ended.as_ref(),
+        &[
+            Request::Answer { to: ReplyTo::new(Token::new(9)), outcome: Outcome::Cancelled },
+            Request::Closed { session: Token::new(1) },
+        ]
+    );
+    h.domain.reclaim();
+    assert_eq!(h.domain.jobs(), 0);
+}

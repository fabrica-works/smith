+fn shell_cwd_refuses_outside_and_overlong_paths_before_io() {
+    let mut h = Harness::new(LIMITS);
+    let kit = h.open(1, authority(ALL));
+    for cwd in [b"../../etc".as_slice(), b"/work/temper-other", b"/work", b"/"] {
+        let call = Call::ShellIn { command: bytes(b"pwd"), timeout: None, cwd: path(cwd) };
+        assert_eq!(h.call(kit, call), Outcome::Outside);

+        (b"vendor/lib/tests", 2, b"tests"),
+        (b"/work/temper/vendor/lib", 2, b""),
+        (b"vendor/lib/../other", 1, b"vendor/other"),
+        (b"../docs", 3, b""),
+        (b"/work/docs/./guide", 3, b"guide"),
+        (b"", 1, b""),
+        (b".", 1, b""),
+    ];
+    for (cwd, root, relative) in cases {
+        let call = Call::ShellIn { command: bytes(b"pwd"), timeout: None, cwd: path(cwd) };
+        assert_eq!(crate::tool(&call), Tool::Shell);
+        assert_eq!(effect(&call), Effect::Write);
+        assert_eq!(crate::result_worst_case(&call, &LIMITS), Some(192));
+        let Some(Request::Io { owner, op: Op::Spawn { cwd: selected, command, env, roots, head, tail }, .. }) =
+            h.send(kit, 7, call)
+        else {
+            panic!("expected a shell spawn for {cwd:?}");
+        };
+        assert_eq!(selected, place(*root, relative), "{cwd:?}");
+        assert_eq!(command.as_ref(), b"pwd");
+        assert_eq!(env, authority(ALL).env);
+        assert_eq!(
+            roots.as_ref(),
+            &[
+                Root { root: Token::new(1), writable: true },
+                Root { root: Token::new(2), writable: false },
+                Root { root: Token::new(3), writable: false },

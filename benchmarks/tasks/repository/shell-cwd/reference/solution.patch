+/// Selects a call's directory without changing the kit's authority or relative base.
+fn shell(
+    checkout: &Checkout,
+    command: Box<[u8]>,
+    timeout: Option<Duration>,
+    cwd: &Path,
+    limits: &Limits,
+) -> Result<Work, Outcome> {
+    passable(&command)?;
+    let located = authority::locate(checkout, cwd, limits.path_bytes)?;
+    let timeout = timeout.unwrap_or(limits.shell_timeout).min(limits.shell_timeout_max);
+    let env = checkout.env.clone();
+    let roots = checkout.roots.clone();
+    Ok(Work::Shell { cwd: located.place, command, timeout, env, roots })
+}
